{
  "name": "teuton-gui",
  "version": "1.0.0",
  "description": "GUI de escritorio para Teutón: gestión de proyectos, edición visual, ejecución y dashboard de evaluación",
  "homepage": "https://github.com/adr1mt/teuton-gui",
  "repository": {
    "type": "git",
    "url": "https://github.com/adr1mt/teuton-gui.git"
  },
  "desktopName": "teuton-gui",
  "main": "./out/main/index.js",
  "author": {
    "name": "Adrià Muñoz",
    "email": "amuno123@xtec.cat"
  },
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run verify:preload",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "verify:parsing": "esbuild scripts/verify-parsing.ts --bundle --platform=node --format=esm --outfile=/tmp/teuton-verify.mjs --external:electron && node /tmp/teuton-verify.mjs",
    "verify:preload": "node scripts/verify-preload.mjs",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "icon": "python3 scripts/make-icon.py",
    "test:e2e": "playwright test",
    "screenshot": "esbuild scripts/screenshot.ts --bundle --platform=node --format=esm --outfile=/tmp/teuton-shot.mjs --external:electron && node_modules/electron/dist/electron /tmp/teuton-shot.mjs --no-sandbox"
  },
  "build": {
    "appId": "net.xeill.elpuig.teutongui",
    "productName": "Teuton GUI",
    "copyright": "Copyright © 2026 Adrià Muñoz",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "artifactName": "Teuton-GUI-${version}.${ext}",
      "icon": "build/icons",
      "category": "Education",
      "synopsis": "Interfaz gráfica para Teutón",
      "description": "Corrige prácticas con Teutón y publica notas en Moodle.",
      "desktop": {
        "entry": {
          "Name": "Teutón GUI",
          "Keywords": "teuton;evaluacion;notas;aula;",
          "StartupWMClass": "teuton-gui"
        }
      },
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.408.0",
    "monaco-editor": "^0.50.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^4.5.4"
  }
}
